{
  "name": "learning-platform-admin",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run build:pages && node --test tests/*.test.mjs && npm run test:authoring",
    "test:unit": "node --test tests/architecture.test.mjs tests/responsive.test.mjs",
    "test:authoring": "node --experimental-strip-types --test tests/authoring.test.ts tests/authoring-context.test.ts tests/authoring-storage.test.ts tests/authoring-workspace-context.test.ts tests/authoring-interop.test.ts tests/publication.test.ts tests/week-visibility-publish.test.ts tests/admin-portal-navigation.test.ts tests/admin-module-lazy-loading.test.ts tests/admin-module-loading-lifecycle.test.ts tests/hub-registration.test.ts tests/results-markbook.test.ts tests/analytics.test.ts tests/readiness-diagnostic.test.ts tests/admin-read-pagination.test.ts tests/async-authoring.test.ts tests/composition-engine.test.ts tests/materialise.test.ts tests/remote-draft.test.ts",
    "build:activity-template": "node scripts/build-activity-template.mjs",
    "test:accessibility": "npm run build && node --test tests/accessibility.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@learning-platform/content": "file:../learning-platform-content",
    "@learning-platform/core": "file:../learning-platform-core",
    "@learning-platform/results": "file:../learning-platform-results",
    "@supabase/supabase-js": "2.112.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "^4.13.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

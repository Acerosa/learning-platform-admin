{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.hub",
  "title": "Learning Platform content hub",
  "description": "Hub-level presentation document. Not the backend registration manifest. Points at a curriculum; does not contain teaching content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships"],
  "properties": {
    "schema": { "const": "lp.content.hub" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "branding": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "accent": { "type": "string" }
          }
        },
        "routes": { "type": "object", "additionalProperties": { "type": "string" } },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "relationships": {
      "type": "object",
      "required": ["curriculum"],
      "additionalProperties": false,
      "properties": {
        "curriculum": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.block",
  "title": "Learning Platform block",
  "description": "Atomic rendering unit. An activity is an ordered list of blocks. Unknown types are rejected; registered but unimplemented types render as placeholders.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships", "type"],
  "properties": {
    "schema": { "const": "lp.content.block" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "type": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "relationships": {
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "asset": { "type": "string" }
      }
    },
    "content": { "type": "object" }
  }
}

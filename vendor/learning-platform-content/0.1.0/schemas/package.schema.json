{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.package",
  "title": "Learning Platform content package index",
  "description": "Loader index listing canonical JSON files. Not teaching content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships"],
  "properties": {
    "schema": { "const": "lp.content.package" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metadata": { "type": "object" },
    "relationships": {
      "type": "object",
      "required": ["hub", "curriculum"],
      "properties": {
        "hub": { "type": "string" },
        "curriculum": { "type": "string" },
        "learningOutcomes": { "type": "string" },
        "assignments": { "type": "string" },
        "weeks": { "type": "string" },
        "sessions": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "activities": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "questions": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "assets": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
      }
    }
  }
}

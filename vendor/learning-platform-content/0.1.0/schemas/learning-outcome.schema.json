{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.learning-outcome",
  "title": "Learning Platform learning outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships"],
  "properties": {
    "schema": { "const": "lp.content.learning-outcome" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metadata": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "relationships": { "type": "object" }
  }
}

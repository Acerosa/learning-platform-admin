{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.session",
  "title": "Learning Platform session",
  "description": "First-class teaching session. Typical kinds: session, independent-study, homework, revision, retrieval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships"],
  "properties": {
    "schema": { "const": "lp.content.session" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metadata": {
      "type": "object",
      "required": ["title", "kind"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["session", "independent-study", "homework", "revision", "retrieval"]
        },
        "summary": { "type": "string" },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "defaultOpen": { "type": "boolean" }
      }
    },
    "relationships": {
      "type": "object",
      "required": ["activities"],
      "properties": {
        "week": { "type": "string" },
        "activities": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

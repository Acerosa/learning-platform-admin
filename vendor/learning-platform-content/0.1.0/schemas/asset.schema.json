{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.asset",
  "title": "Learning Platform asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships"],
  "properties": {
    "schema": { "const": "lp.content.asset" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metadata": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["image", "video", "file", "link"] },
        "href": { "type": "string" },
        "alt": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "relationships": { "type": "object" }
  }
}

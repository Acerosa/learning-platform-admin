{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.week",
  "title": "Learning Platform week",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships"],
  "properties": {
    "schema": { "const": "lp.content.week" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metadata": {
      "type": "object",
      "required": ["teachingWeek", "title", "status"],
      "properties": {
        "teachingWeek": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "available", "archived"] },
        "phase": { "type": "string" },
        "professionalPractice": { "type": "string" },
        "route": { "type": "string" },
        "weekCommencing": { "type": ["string", "null"] },
        "releaseDate": { "type": ["string", "null"] },
        "dueDate": { "type": ["string", "null"] }
      }
    },
    "relationships": {
      "type": "object",
      "required": ["learningOutcomes"],
      "properties": {
        "curriculum": { "type": "string" },
        "learningOutcomes": { "type": "array", "items": { "type": "string" } },
        "assignment": { "type": ["string", "null"] },
        "sessions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

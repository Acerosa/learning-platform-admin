{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lp.content.assignment",
  "title": "Learning Platform assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "version", "metadata", "relationships"],
  "properties": {
    "schema": { "const": "lp.content.assignment" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metadata": {
      "type": "object",
      "required": ["title", "status"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "key": { "type": "string" },
        "status": { "enum": ["planned", "available", "archived"] },
        "route": { "type": "string" },
        "evidenceNote": { "type": "string" },
        "releaseDate": { "type": ["string", "null"] },
        "dueDate": { "type": ["string", "null"] },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "summary": { "type": "string" }
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "week": { "type": "integer" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "object",
      "properties": {
        "learningOutcomes": { "type": "array", "items": { "type": "string" } },
        "weeks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
